# LF in the repository and in every checkout, whatever core.autocrlf is on the machine.
* text=auto eol=lf

*.zip   binary -delta
*.dll   binary
*.nupkg binary -delta

# Autodesk files stay byte for byte as supplied: no line ending conversion, and no text diff of the large XML files.
# This section stays last, because a later line overrides an earlier one.
Source/Content/**       -text
Source/Content/**/*.xml -diff
